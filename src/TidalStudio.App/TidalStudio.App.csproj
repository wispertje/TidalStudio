<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/logo/MakeLogo.cs -->
    <ApplicationIcon>Assets\TidalStudio.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>TidalStudio</AssemblyName>
    <RootNamespace>TidalStudio.App</RootNamespace>
    <Version>0.1.0</Version>
    <!-- dotnet publish -c Release -r win-x64 produces one self-contained TidalStudio.exe -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
    <AvaloniaResource Include="Assets\**\*" />
    <ProjectReference Include="..\TidalStudio.Core\TidalStudio.Core.csproj" />
  </ItemGroup>
  <!-- Muse's training scripts (run with the Python environment TidalStudio sets up), next to the exe in ml\. -->
  <ItemGroup>
    <None Include="..\..\ml\**\*.py;..\..\ml\requirements.txt" Exclude="..\..\ml\**\__pycache__\**" Link="ml\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- SkiaSharp/HarfBuzz ship ~100 MB of native .pdb files; they are not needed to run the app. -->
  <Target Name="RemoveNativePdbs" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb;$(PublishDir)libHarfBuzzSharp.pdb" />
  </Target>
</Project>
