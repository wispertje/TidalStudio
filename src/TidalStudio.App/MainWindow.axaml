<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:ex="using:TidalStudio.App.Explorer"
        xmlns:ed="using:TidalStudio.App.Editor"
        x:Class="TidalStudio.App.MainWindow"
        Title="TidalStudio"
        Icon="avares://TidalStudio/Assets/TidalStudio.ico"
        Width="1400" Height="900"
        MinWidth="700" MinHeight="400"
        Background="{StaticResource TsWindowBackground}">
    <Panel>
    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" Background="{StaticResource TsPanelBackground}">
            <MenuItem Header="_File">
                <MenuItem Header="_New tab" InputGesture="Ctrl+N" Click="OnNew" />
                <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="OnOpen" />
                <MenuItem Header="Open _recent" x:Name="RecentMenu" />
                <MenuItem Header="Set _working directory…" Click="OnChooseWorkingDirectory" />
                <Separator />
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSave" />
                <MenuItem Header="Save _as…" InputGesture="Ctrl+Shift+S" Click="OnSaveAs" />
                <Separator />
                <MenuItem Header="_Close tab" InputGesture="Ctrl+W" Click="OnCloseTab" />
                <MenuItem Header="Close _all tabs" Click="OnCloseAllTabs" />
                <MenuItem Header="Next tab" InputGesture="Ctrl+Tab" Click="OnNextTab" />
                <MenuItem Header="Previous tab" InputGesture="Ctrl+Shift+Tab" Click="OnPreviousTab" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Tidal">
                <MenuItem Header="Run _line" InputGesture="Shift+Enter" Click="OnRunLine" />
                <MenuItem Header="Run _block / selection" InputGesture="Ctrl+Enter" Click="OnRunBlock" />
                <MenuItem Header="_Hush" InputGesture="Ctrl+Alt+H" Click="OnHush" />
                <Separator />
                <MenuItem Header="_Start / restart Tidal" Click="OnRestartTidal" />
                <MenuItem Header="S_top Tidal" Click="OnStopTidal" />
                <Separator />
                <MenuItem Header="Boot file">
                    <MenuItem Header="Automatic (next to the file, else built-in)" x:Name="BootAutoItem" ToggleType="Radio" GroupName="boot" Click="OnBootAuto" />
                    <MenuItem Header="Always use the built-in boot file" x:Name="BootBuiltInItem" ToggleType="Radio" GroupName="boot" Click="OnBootBuiltIn" />
                    <MenuItem Header="Choose a boot file…" x:Name="BootCustomItem" ToggleType="Radio" GroupName="boot" Click="OnBootChoose" />
                    <Separator />
                    <MenuItem Header="Write TidalStudio's BootTidal.hs next to this file…" Click="OnInstallBoot" />
                </MenuItem>
                <MenuItem Header="Choose ghci…" Click="OnChooseGhci" />
                <MenuItem Header="Start Tidal when TidalStudio opens" x:Name="AutoStartItem" ToggleType="CheckBox" Click="OnToggleAutoStart" />
            </MenuItem>
            <MenuItem Header="_SuperCollider">
                <MenuItem Header="_Start SuperDirt" Click="OnStartSuperDirt" />
                <MenuItem Header="S_top SuperDirt" Click="OnStopSuperDirt" />
                <MenuItem Header="Choose sclang…" Click="OnChooseSclang" />
                <MenuItem Header="Start SuperDirt automatically when it is not running" x:Name="AutoDirtItem" ToggleType="CheckBox" Click="OnToggleAutoDirt" />
            </MenuItem>
            <MenuItem Header="Sy_nth">
                <MenuItem Header="Tidepool sample synth…" InputGesture="Ctrl+Shift+Y" Click="OnOpenSynth" />
                <MenuItem Header="Tidepool Drums (drum kit synth)…" InputGesture="Ctrl+Shift+U" Click="OnOpenDrums" />
                <MenuItem Header="Tidepool Acid (bassline box)…" InputGesture="Ctrl+Shift+J" Click="OnOpenAcid" />
                <MenuItem Header="Tidepool FM (6-operator FM synth)…" InputGesture="Ctrl+Shift+K" Click="OnOpenFm" />
                <MenuItem Header="Render all factory presets to samples…" Click="OnRenderAllPresets" />
                <Separator />
                <MenuItem Header="Example scripts">
                    <MenuItem Header="Using Tidepool synth samples" Click="OnOpenExample" Tag="01-tidepool-synth.tidal" />
                    <MenuItem Header="Using Tidepool Drums kits" Click="OnOpenExample" Tag="02-tidepool-drums.tidal" />
                    <MenuItem Header="Using Tidepool Acid loops" Click="OnOpenExample" Tag="03-tidepool-acid.tidal" />
                    <MenuItem Header="Using Tidepool FM samples" Click="OnOpenExample" Tag="05-tidepool-fm.tidal" />
                    <MenuItem Header="Synthwave sketch (80s presets of all four synths)" Click="OnOpenExample" Tag="06-synthwave.tidal" />
                    <MenuItem Header="Synth pop sketch (all three synths)" Click="OnOpenExample" Tag="04-synth-pop-song.tidal" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="VJ screen (visuals for a performance)…" InputGesture="Ctrl+Shift+V" Click="OnOpenVj" />
                <Separator />
                <MenuItem Header="Add visualizer" x:Name="AddVisualizerMenu" />
                <MenuItem Header="Reset visualizers" Click="OnResetVisualizers" />
                <MenuItem Header="Show file explorer" x:Name="ShowExplorerItem" ToggleType="CheckBox" InputGesture="Ctrl+Shift+E" Click="OnToggleExplorer" />
                <MenuItem Header="Show visualizer panel" x:Name="ShowPanelItem" ToggleType="CheckBox" Click="OnTogglePanel" />
                <Separator />
                <MenuItem Header="Highlight mini-notation" x:Name="HighlightItem" ToggleType="CheckBox" Click="OnToggleHighlight" />
                <MenuItem Header="Highlight style">
                    <MenuItem Header="Background" x:Name="StyleBackgroundItem" ToggleType="Radio" GroupName="hl" Click="OnHighlightStyle" Tag="Background" />
                    <MenuItem Header="Outline" x:Name="StyleOutlineItem" ToggleType="Radio" GroupName="hl" Click="OnHighlightStyle" Tag="Outline" />
                    <MenuItem Header="Underline" x:Name="StyleUnderlineItem" ToggleType="Radio" GroupName="hl" Click="OnHighlightStyle" Tag="Underline" />
                </MenuItem>
                <MenuItem Header="Inline visuals (-- _punchcard …)" x:Name="InlineItem" ToggleType="CheckBox" Click="OnToggleInline" />
                <MenuItem Header="Audio capture (scope / spectrum)" x:Name="AudioItem" ToggleType="CheckBox" Click="OnToggleAudio" />
                <Separator />
                <MenuItem Header="Autocomplete while typing (Ctrl+Space always works)" x:Name="AutocompleteItem" ToggleType="CheckBox" Click="OnToggleAutocomplete" />
                <MenuItem Header="Line numbers" x:Name="LineNumbersItem" ToggleType="CheckBox" Click="OnToggleLineNumbers" />
                <MenuItem Header="Word wrap" x:Name="WordWrapItem" ToggleType="CheckBox" Click="OnToggleWordWrap" />
                <MenuItem Header="Bigger font" InputGesture="Ctrl+OemPlus" Click="OnFontBigger" />
                <MenuItem Header="Smaller font" InputGesture="Ctrl+OemMinus" Click="OnFontSmaller" />
                <Separator />
                <MenuItem Header="Clear console" Click="OnClearConsole" />
                <MenuItem Header="Open settings file" Click="OnOpenSettingsFile" />
            </MenuItem>
            <MenuItem Header="_Muse">
                <MenuItem Header="Suggest a part (melody, bass, drums, chords, new part)…" InputGesture="Ctrl+Shift+G" Click="OnMuseSuggest" />
                <MenuItem Header="Muse trainer (data, train by ear, training, versions)…" InputGesture="Ctrl+Shift+M" Click="OnMuseTrainer" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Keyboard shortcuts &amp; tips" Click="OnShowHelp" />
                <MenuItem Header="About TidalStudio" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource TsPanelBackground}" BorderBrush="{StaticResource TsBorder}" BorderThickness="0,1,0,0" Height="26">
            <DockPanel>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="10,0,0,0" Fill="#8A93A6" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusTidal" Classes="status" Text="Tidal: stopped" Margin="6,0,10,0" />
                <Ellipse x:Name="StatusDirtDot" Width="8" Height="8" Margin="4,0,0,0" Fill="#8A93A6" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusDirt" Classes="status" Text="SuperDirt: ?" Margin="6,0,10,0" />
                <TextBlock x:Name="StatusCycle" Classes="status" FontFamily="Cascadia Mono, Consolas, monospace" />
                <TextBlock x:Name="StatusMuted" Classes="status" Foreground="#FFD166" />
                <TextBlock x:Name="StatusFile" Classes="status" DockPanel.Dock="Right" />
                <TextBlock x:Name="StatusAudio" Classes="status" DockPanel.Dock="Right" />
                <TextBlock x:Name="StatusEvents" Classes="status" DockPanel.Dock="Right" />
                <TextBlock x:Name="StatusMessage" Classes="status" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid x:Name="MainGrid" ColumnDefinitions="240,4,*,4,380">
            <ex:FileExplorer x:Name="Explorer" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Background="{StaticResource TsBorder}" ResizeDirection="Columns" />
            <Grid x:Name="LeftGrid" Grid.Column="2" RowDefinitions="*,4,170">
                <DockPanel Grid.Row="0">
                <ed:TabBar x:Name="Tabs" DockPanel.Dock="Top" />
                <Panel x:Name="EditorArea" Background="{StaticResource TsEditorBackground}">
                    <Grid x:Name="BehindCodeLayer" IsHitTestVisible="False" Opacity="0.35" />
                    <ae:TextEditor x:Name="Editor"
                                   Background="Transparent"
                                   Foreground="#D8DEE9"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="6,4,0,0" />
                </Panel>
                </DockPanel>
                <GridSplitter Grid.Row="1" Background="{StaticResource TsBorder}" ResizeDirection="Rows" />
                <Border Grid.Row="2" Background="#101217">
                    <ae:TextEditor x:Name="ConsoleView"
                                   IsReadOnly="True"
                                   Background="Transparent"
                                   Foreground="#B8C0CF"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="12"
                                   WordWrap="True"
                                   Padding="8,4,4,4"
                                   VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Background="{StaticResource TsBorder}" ResizeDirection="Columns" />
            <DockPanel x:Name="VisualizerPanel" Grid.Column="4" Background="{StaticResource TsWindowBackground}">
                <DockPanel DockPanel.Dock="Top" Margin="10,6,8,6">
                    <Button x:Name="AddVisualizerButton" DockPanel.Dock="Right" Content="+ Add" Classes="icon" />
                    <TextBlock Text="VISUALIZERS" Classes="tileTitle" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="VisualizerStack" Margin="8,0,8,8" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>

    <!-- Shown while Tidal boots at launch. GHC itself needs several seconds to start on Windows. -->
    <Border x:Name="LoadingOverlay" Background="#F214161C" IsVisible="False">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
            </Transitions>
        </Border.Transitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="360">
            <Image Source="avares://TidalStudio/Assets/logo.png" Width="120" Height="120" HorizontalAlignment="Center" />
            <TextBlock Text="TidalStudio" FontSize="26" FontWeight="SemiBold" Foreground="#E6EAF2" HorizontalAlignment="Center" />
            <TextBlock x:Name="LoadingStage" Text="Starting Tidal…" FontSize="13" Foreground="{StaticResource TsAccent}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <ProgressBar x:Name="LoadingProgress" Minimum="0" Maximum="1" Height="4" MinHeight="4"
                         Foreground="{StaticResource TsAccent}" Background="{StaticResource TsBorder}" />
            <TextBlock x:Name="LoadingDetail" FontSize="12" Foreground="{StaticResource TsMuted}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="LoadingSkip" Content="Continue without waiting  (Esc)" Classes="icon" HorizontalAlignment="Center"
                    Foreground="{StaticResource TsMuted}" Margin="0,6,0,0" Click="OnSkipLoading" />
        </StackPanel>
    </Border>
    </Panel>
</Window>
