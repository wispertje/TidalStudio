<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TidalStudio.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="TsWindowBackground" Color="#14161C" />
        <SolidColorBrush x:Key="TsPanelBackground" Color="#1A1D24" />
        <SolidColorBrush x:Key="TsEditorBackground" Color="#171A21" />
        <SolidColorBrush x:Key="TsBorder" Color="#2A2F3A" />
        <SolidColorBrush x:Key="TsMuted" Color="#8A93A6" />
        <SolidColorBrush x:Key="TsAccent" Color="#4ECDC4" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{StaticResource TsPanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource TsBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.tileTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TsMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.icon">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TsMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
    </Application.Styles>
</Application>
