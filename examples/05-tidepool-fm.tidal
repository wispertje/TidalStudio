-- ============================================================================
-- Tidepool FM (Synth ▸ Tidepool FM) — how to play the FM samples it makes
-- ============================================================================
-- Run a block: put the cursor in it and press Ctrl+Enter.  Stop everything: Ctrl+Alt+H.
--
-- How an FM sound is stored (exactly like the Tidepool synth)
--   One sample per note in the "Notes" box, in <samples folder>/<name>/:
--   * n    picks the rendered note (the octave). The presets render several octaves,
--          e.g. "Tine piano" renders c3 c4 c5 c6, so n 0 = c3 … n 3 = c6.
--   * note shifts the pitch from there in semitones (rendered on c, so note names line up).
--   FM sounds change character with pitch (a low electric piano is darker and longer than
--   a high one), so pick the closest octave with n instead of pitching one sample far.
--
-- The names below are the presets' default names: fmepiano, fmglass, fmmarimba, fmbell,
-- fmclav, fmorgan, fmsolid, fmrubber, fmslap, fmmetal, fmbrass, fmlead, fmflute, fmpad,
-- fmgamelan, fmkick, fmhit, fmwood, and the synth pop ones fmpopep, fmpopbass,
-- fmpopbrass, fmpopbell, fmpopmallet. Save a preset first (💾), or change the name.

setcps (112/60/4)

-- 1. The electric piano as rendered (n 2 = c5)
d1 $ s "fmepiano" # n 2

-- 2. Electric piano chords: n 1 is the c4 sample, so the chords sit in the warm middle.
--    legato 1 makes each chord last its step.
d1 $ note "<c'maj7 a4'min7 f4'maj7 g4'dom7>" # s "fmepiano" # n 1 # legato 1

-- 3. The same, broken up into a gentle rhythm with struct
d1 $ struct "t ~ ~ t ~ t ~ ~" $ note "<c'maj7 a4'min7 f4'maj7 g4'dom7>"
   # s "fmepiano" # n 1 # legato 2 # gain 0.9

-- 4. The classic 80s FM bass: octave jumps between the c2 (n 0) and c3 (n 1) samples.
--    cut 1 keeps it monophonic: each note stops the one before.
d2 $ n "0 1 0 1 0 1 0 1" # s "fmsolid" # note "<c a4 f4 g4>" # cut 1

-- … or slap it, with a few ghost notes left out at random
d2 $ degradeBy 0.15 $ n "0 ~ 1 0 ~ 0 1 ~" # s "fmslap" # note "<c a4 f4 g4>" # cut 1

-- 5. Mallets: marimba arpeggios (n 1 = c5) and bells on top
do
  d3 $ arp "<up downup>" $ note "<c'maj'6 a4'min'6>" # s "fmmarimba" # n 1 # gain 0.85
  d4 $ slow 2 $ note "c ~ g ~ e ~ ~ ~" # s "fmbell" # n 1 # room 0.4 # size 0.8

-- 6. Brass stabs on the off-beats (n 0 = c4)
d5 $ struct "~ t ~ [~ t]" $ note "<c'maj a4'min f4'maj g4'maj>" # s "fmbrass" # n 0 # legato 0.5

-- 7. A pad underneath, long and soft
d6 $ note "<c'maj9 a4'min9 f4'maj9 g4'sus4>" # s "fmpad" # n 0 # legato 1 # gain 0.75

-- 8. FM percussion: the kick drops in pitch, the metal hit and wood block add a groove
do
  d7 $ s "fmkick*4"
  d8 $ s "~ fmhit ~ fmhit" # gain 0.8 # speed "<1 1.05>"
  d9 $ s "fmwood*8" # n "0 1" # gain (range 0.6 0.9 rand)

-- 9. Drawbar organ chords with a slow filter sweep in SuperDirt
d6 $ note "<c'maj e'min f'maj g'maj>" # s "fmorgan" # n 1 # legato 1
   # lpf (range 1200 6000 $ slow 8 sine)

-- 10. Synth pop: EP chords, octave bass, bell lead and mallet arpeggio together
do
  d1 $ note "<c'maj7 a4'min7 f4'maj7 g4'sus4>" # s "fmpopep" # n 0 # legato 1
  d2 $ n "0 1 0 1 0 1 0 1" # s "fmpopbass" # note "<c a4 f4 g4>" # cut 1
  d3 $ arp "up" $ note "<c'maj'5 a4'min'5 f4'maj'5 g4'maj'5>" # s "fmpopmallet" # n 1 # gain 0.75
  d4 $ slow 2 $ note "e ~ g ~ a g e d" # s "fmpopbell" # n 0 # legato 1
  d5 $ struct "~ t ~ t" $ note "<c'maj a4'min f4'maj g4'maj>" # s "fmpopbrass" # n 0 # legato 0.4 # gain 0.8

hush
